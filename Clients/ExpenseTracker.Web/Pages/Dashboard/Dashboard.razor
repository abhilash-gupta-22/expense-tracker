@page "/"

@using ExpenseTracker.Web.Components.Dashboard
@using ExpenseTracker.Web.Models.Dashboard
@using ExpenseTracker.Web.Models.Expense
@using ExpenseTracker.Web.Services.Interfaces

@inject IBudgetApiClient BudgetApiClient
@inject ICategoryApiClient CategoryApiClient
@inject IExpenseApiClient ExpenseApiClient

<PageTitle>Dashboard - Expense Tracker</PageTitle>

<div class="dashboard-page">

    <div class="page-title">

        <h2>Dashboard</h2>

        <p>
            Overview of your monthly budget and expenses.
        </p>

    </div>

    <BudgetSummary TotalBudget="@TotalBudget"
                   TotalExpenses="@TotalExpenses" />

    <div class="dashboard-grid">

        <BudgetOverview />

        <ExpensesTrend />

    </div>

    <div class="dashboard-grid">

        <RecentExpenses Expenses="@RecentExpenses"
                        MaxItems="5" />

        <TopCategories Categories="@CategoryBudgets " />

    </div>

</div>

@code {

    private decimal TotalBudget { get; set; }

    private decimal TotalExpenses { get; set; }

    private IEnumerable<ExpenseModel> RecentExpenses { get; set; } = Enumerable.Empty<ExpenseModel>();

    private List<CategoryBudgetItem> CategoryBudgets { get; set; } = new();
}
