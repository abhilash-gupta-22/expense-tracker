<div class="dashboard-card top-categories">

    <div class="card-header">
        <h2>Top Categories</h2>

        <a href="/categories" class="view-all">
            View all
        </a>
    </div>

    @if (Categories is null || !Categories.Any())
    {
        <div class="empty-state">
            No categories available.
        </div>
    }
    else
    {
        <div class="category-list">

            @foreach (var category in Categories.OrderByDescending(x => x.SpentAmount).Take(4))
            {
                var percentage =
                    category.AllocatedBudget <= 0
                        ? 0
                        : Math.Min(category.SpentAmount / category.AllocatedBudget * 100, 100);

                <div class="category-item">

                    <div class="category-main">
                        <span class="category-name">
                            @category.Name
                        </span>

                        <span class="category-amount">
                            @FormatCurrency(category.SpentAmount)
                        </span>

                        <span class="category-percentage">
                            @percentage.ToString("0.0")%
                        </span>
                    </div>

                    <div class="category-progress">
                        <div class="progress-track">
                            <div class="progress-value"
                                 style="width:@percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; background:@GetCategoryColor(category.Name)">
                            </div>
                        </div>
                    </div>

                </div>
            }
        </div>
    }

</div>

@code {

    [Parameter]
    public IEnumerable<CategoryBudgetItem>? Categories { get; set; }

    private static string GetCategoryColor(string name)
    {
        var hash = Math.Abs(name.GetHashCode());

        return (hash % 4) switch
        {
            0 => "#22b573",
            1 => "#f5b700",
            2 => "#ef5350",
            _ => "#3984e9"
        };
    }

    private static string FormatCurrency(decimal amount)
    {
        return $"₹ {amount:N2}";
    }

    public class CategoryBudgetItem
    {
        public Guid Id { get; set; }

        public string Name { get; set; } = string.Empty;

        public decimal AllocatedBudget { get; set; }

        public decimal SpentAmount { get; set; }
    }
}