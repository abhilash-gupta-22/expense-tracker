@using ExpenseTracker.Web.Models.Expense

<div class="dashboard-card trend-card">

    <div class="card-header">
        <h2>Expenses Trend</h2>

        <select @bind="SelectedPeriod" class="period-select">
            <option value="This Month">
                This Month
            </option>
            <option value="Last Month">
                Last Month
            </option>
        </select>
    </div>

    <div class="chart-container">

        @if (Points.Count == 0)
        {
            <div class="chart-empty">
                No expense data available.
            </div>
        }
        else
        {
            <svg viewBox="0 0 500 180"
                 preserveAspectRatio="none"
                 class="trend-chart">

                <!-- Grid -->
                <line x1="45" y1="20"
                      x2="485" y2="20"
                      class="grid-line" />

                <line x1="45" y1="55"
                      x2="485" y2="55"
                      class="grid-line" />

                <line x1="45" y1="90"
                      x2="485" y2="90"
                      class="grid-line" />

                <line x1="45" y1="125"
                      x2="485" y2="125"
                      class="grid-line" />

                <!-- Area -->

                <path d="@AreaPath" class="chart-area" />

                <!-- Line -->

                <polyline points="@PolylinePoints" class="chart-line" />

                <!-- Points -->
                @foreach (var point in Points)
                {
                    <circle cx="@point.X"
                            cy="@point.Y"
                            r="2.5"
                            class="chart-point" />
                }

                <!-- Y axis -->
                <text x="5" y="24"
                      class="axis-label">
                    @FormatAxis(MaxValue)
                </text>
                <text x="5" y="59"
                      class="axis-label">
                    @FormatAxis(MaxValue * .75m)
                </text>
                <text x="5" y="94"
                      class="axis-label">
                    @FormatAxis(MaxValue * .5m)
                </text>
                <text x="5" y="129"
                      class="axis-label">
                    @FormatAxis(MaxValue * .25m)
                </text>
                <text x="5" y="164"
                      class="axis-label">
                    ₹ 0
                </text>
            </svg>
        }

    </div>

</div>


@code {

    [Parameter]
    public IEnumerable<ExpenseModel>? Expenses { get; set; }

    private string SelectedPeriod { get; set; } = "This Month";

    private List<ChartPoint> Points { get; set; } = new();

    private decimal MaxValue { get; set; }

    private string PolylinePoints => string.Join(" ", Points.Select(point => $"{point.X},{point.Y}"));

    private string AreaPath
    {
        get
        {
            if (Points.Count == 0)
                return string.Empty;

            var first = Points.First();
            var last = Points.Last();

            return
                $"M {first.X},{first.Y} " +
                string.Join(
                    " ",
                    Points.Skip(1)
                        .Select(p => $"L {p.X},{p.Y}")) +
                $" L {last.X},155 " +
                $" L {first.X},155 Z";
        }
    }

    protected override void OnParametersSet()
    {
        BuildChart();
    }

    private void BuildChart()
    {
        Points.Clear();

        if (Expenses is null)
            return;

        var expenseList = Expenses.OrderBy(x => x.ExpenseDate).ToList();

        if (expenseList.Count == 0)
            return;

        var grouped = expenseList.GroupBy(x => x.ExpenseDate.Date)
            .Select(group => new
            {
                Date = group.Key,
                Amount = group.Sum(x => x.Amount)
            }).ToList();

        MaxValue = grouped.Max(x => x.Amount);

        if (MaxValue <= 0)
            MaxValue = 1;

        var width = 430m;
        var height = 130m;

        var startX = 55m;
        var startY = 20m;

        var count = grouped.Count;

        for (var i = 0; i < count; i++)
        {
            var item = grouped[i];

            var x = count == 1
                ? startX
                : startX + (width * i / (count - 1));

            var y = startY + height - ((item.Amount / MaxValue) * height);

            Points.Add(new ChartPoint
            {
                X = x,
                Y = y
            });
        }
    }

    private static string FormatAxis(decimal amount)
    {
        if (amount >= 1000)
            return $"₹{amount / 1000:0.#}K";

        return $"₹{amount:0}";
    }

    private sealed class ChartPoint
    {
        public decimal X { get; set; }

        public decimal Y { get; set; }
    }
}
