@using ExpenseTracker.Web.Models.Expense

<div class="dashboard-card recent-expenses">

    <div class="card-header">

        <h2>Recent Expenses</h2>

        <a href="/expenses"
           class="view-all">
            View all
        </a>

    </div>


    @if (Expenses is null || !Expenses.Any())
    {
        <div class="empty-state">
            No expenses recorded yet.
        </div>
    }
    else
    {
        <div class="expense-list">

            @foreach (var expense in Expenses
                .OrderByDescending(x => x.ExpenseDate)
                .Take(MaxItems))
            {
                <div class="expense-item">

                    <div class="expense-icon">
                        @GetIcon(expense.BudgetCategoryName)
                    </div>


                    <div class="expense-description">

                        <strong>
                            @GetDescription(expense)
                        </strong>

                        <span>
                            @expense.BudgetCategoryName
                        </span>

                    </div>


                    <div class="expense-value">

                        <strong>
                            @FormatCurrency(expense.Amount)
                        </strong>

                        <span>
                            @expense.ExpenseDate.ToString("MMM dd, yyyy")
                        </span>

                    </div>

                </div>
            }

        </div>
    }

</div>


@code {

    [Parameter]
    public IEnumerable<ExpenseModel>? Expenses { get; set; }

    [Parameter]
    public int MaxItems { get; set; } = 3;

    private static string GetDescription(ExpenseModel expense)
    {
        return string.IsNullOrWhiteSpace(expense.Remarks)
            ? expense.BudgetCategoryName ?? "Expense"
            : expense.Remarks;
    }

    private static string GetIcon(string? category)
    {
        if (string.IsNullOrWhiteSpace(category))
            return "₹";

        return category.ToLowerInvariant() switch
        {
            var value when value.Contains("grocery") => "🛒",
            var value when value.Contains("food") => "🍴",
            var value when value.Contains("bill") => "⚡",
            var value when value.Contains("utility") => "⚡",
            var value when value.Contains("transport") => "🚗",
            var value when value.Contains("shopping") => "🛍",
            _ => "₹"
        };
    }

    private static string FormatCurrency(decimal amount)
    {
        return $"₹ {amount:N2}";
    }
}
