@inherits LayoutComponentBase

<div class="app-layout">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">
                ₹
            </div>

            <span>
                Expense Tracker
            </span>

        </div>

        <nav class="sidebar-navigation">

            <NavLink href="/" Match="NavLinkMatch.All" class="nav-item">
                <span class="nav-icon">⌂</span>
                <span>Dashboard</span>
            </NavLink>

            <NavLink href="/budgets" class="nav-item">
                <span class="nav-icon">▣</span>
                <span>Budgets</span>
            </NavLink>

            <NavLink href="/categories" class="nav-item">
                <span class="nav-icon">⊞</span>
                <span>Categories</span>
            </NavLink>

            <NavLink href="/expenses" class="nav-item">
                <span class="nav-icon">▤</span>
                <span>Expenses</span>
            </NavLink>

            <NavLink href="/reports" class="nav-item">
                <span class="nav-icon">◩</span>
                <span>Reports</span>
            </NavLink>

            <NavLink href="/settings" class="nav-item">
                <span class="nav-icon">⚙</span>
                <span>Settings</span>
            </NavLink>
        </nav>

        <div class="sidebar-month">
            <span class="month-label">
                Current Month
            </span>

            <div class="month-value">
                May 2025
            </div>
        </div>
    </aside>


    <main class="main-content">
        <header class="topbar">
            <div class="welcome">
                <h1>
                    Welcome back, Abhilash 👋
                </h1>

                <p>
                    Here's what's happening with your budget this month.
                </p>
            </div>

            <div class="topbar-actions">
                <button class="notification-button">
                    🔔
                </button>

                <div class="user-avatar">
                    A
                </div>
            </div>

        </header>


        <section class="content">
            @Body
        </section>

    </main>

</div>